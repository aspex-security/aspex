{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@0.6.2", "__DEMO_HOME__"]
    },
    "browser": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.30"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "env": { "GITHUB_TOKEN": "$(security find-generic-password -s aspex-demo -w)" }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@0.6.2"]
    }
  }
}
